{
  "rewrites": [
    {
      "source": "/turf/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|whatsapp|facebook|twitter|linkedin|skype|slack|telegram|applebot).*"
        }
      ],
      "destination": "https://api.scoreverse.in/api/turfs/share/:id"
    },
    { "source": "/tournament/:id*", "destination": "/tournament/index.html" },
    { "source": "/match/:id*", "destination": "/match/index.html" },
    { "source": "/search/:path*", "destination": "/search/index.html" },
    { "source": "/search", "destination": "/search/index.html" },
    { "source": "/:path*-in-:location*", "destination": "/search/index.html" },
    { "source": "/turf/:id*", "destination": "/turf/index.html" },
    { "source": "/player/:id*", "destination": "/player/index.html" },
    { "source": "/blog/:path*", "destination": "/blog/index.html" },
    { "source": "/dashboard/:path*", "destination": "/dashboard/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms-and-conditions", "destination": "/terms/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" }
  ]
}
